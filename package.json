{
  "name": "2step",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "npm run build:css && npm run build:js && npm run copy-files",
    "build:css": "tailwindcss -i ./src/input.css -o ./popup/style.css",
    "build:js": "node scripts/build.js",
    "dev": "npm run build:js -- --dev && tailwindcss -i ./src/input.css -o ./popup/style.css --watch",
    "copy-files": "mkdir -p dist && cp -r manifest.json background.js popup 2fa.directory faq dist/",
    "test": "playwright test",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/cli": "^4.1.18",
    "esbuild": "^0.28.1",
    "esbuild-plugin-vue3": "^0.5.1",
    "tailwindcss": "^4.1.18"
  },
  "dependencies": {
    "vue": "^3.5.26"
  }
}