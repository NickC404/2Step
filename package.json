{
  "name": "2step",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "npm run build:css && npm run build:js && npm run copy-files",
    "build:css": "tailwindcss -i ./src/input.css -o ./popup/style.css",
    "build:js": "node scripts/build.js",
    "dev": "npm run build:js -- --dev && tailwindcss -i ./src/input.css -o ./popup/style.css --watch",
    "copy-files": "rm -rf dist && mkdir -p dist && cp -r manifest.json background.js icons popup 2fa.directory faq dist/",
    "update:sites": "node scripts/update-sites.js",
    "gen:icons": "node scripts/gen-icons.js",
    "gen:store-assets": "node scripts/gen-store-assets.js",
    "test": "playwright test",
    "preview": "vite preview",
    "package": "npm run build && node scripts/package.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/cli": "^4.3.3",
    "esbuild": "^0.28.2",
    "esbuild-plugin-vue3": "^0.5.1",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "vue": "^3.5.45"
  }
}
